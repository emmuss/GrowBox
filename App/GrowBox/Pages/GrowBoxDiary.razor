@using GrowBox.State
@using Blazor.MinimalApi.Client
@using GrowBox.Abstractions.Model

@page "/growbox/{GrowBoxId:guid}/diary"

@inject IJSRuntime Js
@inject NavigationManager NavigationManager
@inject MinimalHttpClient<DiaryRequest, Diary> DiaryService

@if (_diary != null) 
{
    <RadzenStack Gap="1rem" JustifyContent="JustifyContent.Stretch">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start">
            <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Dark" Click=@(() => Js.InvokeVoidAsync("history.back")) />
        </RadzenStack>
        
        @if (_diary.Timelapses.Length > 0)
        {
            <RadzenAccordion>
                <Items>
                    <RadzenAccordionItem Text="Timelapses" Icon="movie" CollapseTitle="Collapse Timelapses."
                                         ExpandTitle="Expand Timelapses.">
                        @if (_timelapse is not null)
                        {
                            <video width="auto" height="auto" controls style="max-width: 100%">
                                <source src="@_timelapse.Path" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                        }
                        <div style="display: flex; align-items: center; flex-wrap: wrap; justify-content: start; gap: 5px">
                        <RadzenButton Text="Hide" Click="@(() => { _timelapse = null; })" Style="width: 100px;"></RadzenButton>
                        @{
                            int week = 1;
                            foreach (var timelapse in _diary.Timelapses)
                            {
                                string name = $"Week {week}";
                                <RadzenButton Text="@name" Click="@(() => { _timelapse = timelapse; })" Style="width: 100px;"></RadzenButton>
                                week++;
                            }
                        }
                        </div>
                    </RadzenAccordionItem>
                </Items>
            </RadzenAccordion>
        }
        
        <RadzenDatePicker
            @bind-Value=@_selectedDateTime
            Min="_dateTimeMin"
            Max="_dateTimeMax"
            DateRender="DateRender"
            Name="DatePickerMinMax"
            DateFormat="d"/>
        
        <RadzenCarousel Auto="false" PagerOverlay="false" AllowPaging="false" ButtonShade="Shade.Default">
            <Items>
                @foreach (var snapshot in _snapshotsMap[_selectedDateTime].OrderByDescending(x => x.Created))
                {
                    <RadzenCarouselItem>
                        <div>
                            <img src="@snapshot.Url" alt="@snapshot.Created" style="width: 98%; height: 45vh; object-fit:cover; border-radius: 8px; margin-top: 0.5rem"/>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="width: 100%">
                                <a href="@snapshot.Url" target="_blank">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
                                            <RadzenText Text="@snapshot.Created.ToString("f")" Style="margin-bottom: 0"/>
                                            <RadzenIcon Icon="attach_file" IconStyle="IconStyle.Light"/>
                                    </RadzenStack>
                                </a>
                            </RadzenStack>
                        </div>
                    </RadzenCarouselItem>
                }
            </Items>
        </RadzenCarousel>
    </RadzenStack>    
}


@code
{
    private Diary? _diary;
    private DiaryTimelapse? _timelapse;
    private DateTime[] _allDays = [];
    private DateTime _selectedDateTime = DateTime.MinValue;
    private DateTime _dateTimeMin = DateTime.MinValue;
    private DateTime _dateTimeMax = DateTime.MaxValue;
    private Dictionary<DateTime, DiarySnapshot[]> _snapshotsMap = [];
    
    [Parameter] public Guid GrowBoxId { get; set; } = Guid.Empty;
    
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (GrowBoxId == Guid.Empty)
        {
            return;
        }
        _diary = await DiaryService.Get(new DiaryRequest(GrowBoxId));
        if (_diary == null)
        {
            return;
        }

        _snapshotsMap = _diary.Snapshots
            .OrderByDescending(x => x.Created)
            .GroupBy(x => x.Created.Date)
            .ToDictionary(x => x.Key, x => x.ToArray());

        _allDays = _snapshotsMap.Select(d => d.Key).ToArray();
        _dateTimeMin = _snapshotsMap.LastOrDefault().Key;
        _dateTimeMax = _snapshotsMap.FirstOrDefault().Key;
        var first = _snapshotsMap.FirstOrDefault();
        _selectedDateTime = first.Key;
    }
    
    private void DateRender(DateRenderEventArgs args)
    {
        var disabled = !_allDays.Contains(args.Date.Date);

        if (_dateTimeMin == args.Date.Date)
        {
            args.Attributes.Add("style", "background-color: #347736;");
        } 
        else if (args.Date.Date > _dateTimeMin && args.Date.Date < _dateTimeMax)
        {
            if ((args.Date.Date - _dateTimeMin).TotalDays % 7 == 0)
            {
                args.Attributes.Add("style", "background-color: #1666a5;");
            }
        }

        args.Disabled = disabled || args.Disabled;
    }
}
