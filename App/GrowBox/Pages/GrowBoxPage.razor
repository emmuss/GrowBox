@using GrowBox.Controls.GrowBoxChart
@using GrowBox.State
@using GrowBox.Abstractions.Model.EspApi
@using Blazor.MinimalApi.Client
@using GrowBox.Abstractions.Model
@using GrowBox.Services
@using Refit
@using ReactiveComponent = GrowBox.Controls.ReactiveComponent

@page "/growbox/{GrowBoxId:guid}"

@inherits ReactiveComponent

@inject App App
@inject NavigationManager NavigationManager
@inject MinimalHttpClient<SensorReadingRequest, SensorReading[]> SensorReadings
@inject IJSRuntime Js
@inject ILogger<GrowBoxPage> Logger


<RadzenStack Gap="1rem" JustifyContent="JustifyContent.Stretch">
@if (GrowBoxId != Guid.Empty)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenButton Icon="photo_library" ButtonStyle="ButtonStyle.Secondary" Click=@(() => NavigationManager.NavigateTo($"/growbox/{GrowBoxId}/diary"))/>
        <RadzenButton Icon="park" ButtonStyle="ButtonStyle.Secondary" Click="@(() => NavigationManager.NavigateTo($"/growbox/{GrowBoxId}/grows"))" />        
        <RadzenButton Icon="settings" ButtonStyle="ButtonStyle.Dark" Click=@(() => NavigationManager.NavigateTo($"/growbox/{GrowBoxId}/settings"))/>
    </RadzenStack>
}
@if (_growBox != null && _growBoxRoot != null) 
{
    <RadzenCard Variant="Variant.Filled">
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.Subtitle1" TextAlign="TextAlign.Center" style="margin-bottom: 0;">@_growBox.Name</RadzenText>
            <RadzenText TextStyle="TextStyle.H5" TextAlign="TextAlign.Center" style="margin-bottom: 0; font-size: 3rem; font-weight: 100;">@Math.Round(_growBoxRoot.Temperature) °C</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0">
                <RadzenIcon Icon="water_drop"/> <span>@Math.Round(_growBoxRoot.Humidity, 1) %</span>
                <span class="mx-2">|</span>
                <span>@(Math.Round(_growBoxRoot.Pressure / 100, 1)) hpa</span>
            </RadzenStack>
            @if (_waterPumpsRoot != null)
            {
                @foreach (var waterPump in _waterPumpsRoot.Pumps)
                {
                    if (waterPump.AutoPumpBegin == -1)
                        continue;
                    var pumpActivityInSeconds = _waterPumpActivities[waterPump.Id];
                    var mlPumped = _waterPumpsRoot!.PumpMilliLiterPerMinute * TimeSpan.FromSeconds(pumpActivityInSeconds).TotalMinutes;
                    var css = mlPumped <= 0 ? "rz-color-danger" : "";
                    
                    
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="8px">
                        <span class="@css"> Pump @waterPump.Id </span>
                        <RadzenIcon Icon="water" class="@css" />
                        <span class="@css">
                            @(mlPumped.ToString("0.##")) ml
                        </span>
                    </RadzenStack>
                } 
            }
            @if (_growBoxRoot.LightSchedule.SunScheduleEnabled)
            {
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <RadzenText TextStyle="TextStyle.Overline" style="margin-bottom: 0;">@_rise.ToString(@"hh\:mm\:ss")</RadzenText>
                    <div style="display: flex; justify-content: start; align-items: center;">
                        <RadzenIcon Icon="north_east"/>
                        <RadzenIcon Icon="sunny"/>
                    </div>
                    <RadzenText TextStyle="TextStyle.Overline" style="margin-bottom: 0;">@_sunDuration.ToString(@"hh\:mm\:ss")</RadzenText>
                    <div style="display: flex; justify-content: start; align-items: center;">
                        <RadzenIcon Icon="sunny"/>
                        <RadzenIcon Icon="south_east"/>
                    </div>
                    <RadzenText TextStyle="TextStyle.Overline" style="margin-bottom: 0;">@_set.ToString(@"hh\:mm\:ss")</RadzenText>
                </div>
            }
            @if (!string.IsNullOrEmpty(_growBox.WebCamStreamUrl) && 
                 !string.IsNullOrEmpty(_growBox.WebCamSnapshotUrl))
            {
                <a href="@_growBox.WebCamStreamUrl" target="_blank">
                    <img id="webCam" src="@_growBox.WebCamSnapshotUrl" style="width: 100%; object-fit:cover; border-radius: 8px;" alt="Webcam Image Loading..."/>
                </a>
            }
        </RadzenStack>
    </RadzenCard>
    <RadzenCard Variant="Variant.Filled">
        <GrowBoxChart @ref="_chart"/>
    </RadzenCard>
}
</RadzenStack>


@code
{
    private GrowBoxModel? _growBox;
    private GrowBoxEspRoot? _growBoxRoot;
    private WaterPumpsEspRoot? _waterPumpsRoot;
    private GrowBoxChart? _chart;
    private readonly Dictionary<int, double> _waterPumpActivities = new();

    TimeSpan _rise = TimeSpan.Zero;
    TimeSpan _sunDuration = TimeSpan.Zero;
    TimeSpan _set = TimeSpan.Zero;

    [Parameter] public Guid GrowBoxId { get; set; } = Guid.Empty;
    
    protected override void OnInitialized()
    {
        base.OnInitialized();
        ObserveParameter(() => GrowBoxId)
            .Where(x => x != Guid.Empty)
            .Select(App.GetAppGrowBox)
            .Select(x => Observable.FromAsync(() => GetComposition(x)))
            .Switch()
            .Select(x => Observable.FromAsync(() => Update(x)))
            .Switch()
            .Subscribe(_ => {}, (e) => Logger.LogError(e, "Unable to load composition."));
        
        Observable.Timer(TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5))
            .TakeUntil(Disposed)
            .Select(_ => GrowBoxId)
            .Where(x => x != Guid.Empty)
            .Select(App.GetAppGrowBox)
            .Select(x => Observable.FromAsync(() => GetComposition(x)))
            .Switch()
            .Select(x => Observable.FromAsync(() => Update(x)))
            .Switch()
            .Subscribe(_ => {}, (e) => Logger.LogError(e, "Unable to load composition."));
    }

    private record Composition(
        GrowBoxModel GrowBox,
        GrowBoxEspRoot GrowBoxEspRoot, 
        WaterPumpsEspRoot? WaterPumpsEspRoot, 
        SensorReading[] SensorReadings);

    private async Task<Composition> GetComposition(AppGrowBox appGrowBox)
    {
        var growBox = appGrowBox.GrowBox;
        var growBoxService = RestService.For<IGrowBoxEsp>(growBox.GrowBoxUrl);
        var growBoxRoot = await growBoxService.Get();
        var waterPumpsRoot = await GetWaterPumpsRoot(growBox.WaterPumpsUrl);
        var sensorReadings = await GetSensorReadings(waterPumpsRoot);
        return new Composition(
            growBox, 
            growBoxRoot, 
            waterPumpsRoot, 
            sensorReadings);
    }

    private async Task<WaterPumpsEspRoot?> GetWaterPumpsRoot(string? url)
    {
        if (string.IsNullOrEmpty(url))
            return null;
        
        try
        {
            return await RestService.For<IWaterPumpsEsp>(url).Get();
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Unable to request water pumps root.");
        }

        return null;
    }

    private async Task<SensorReading[]> GetSensorReadings(WaterPumpsEspRoot? waterPumpsEspRoot)
    {
        try
        {
            List<string> types = ["temperature", "pressure", "light", "humidity"];
            if (waterPumpsEspRoot is not null)
            {
                types.AddRange(
                    waterPumpsEspRoot.Pumps.Select(x => $"wp{x.Id}_active"));
            }
            
            return await SensorReadings.Get(new SensorReadingRequest(
                types.ToArray(),
                GrowBoxId, DateTime.UtcNow - TimeSpan.FromDays(1), null)) ?? [];
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Unable to get sensor readings.");
        }

        return [];
    }

    private async Task Update(Composition composition)
    {
        Console.WriteLine($"what? {composition.GrowBox.GrowBoxUrl}");
        _growBox = composition.GrowBox;
        _growBoxRoot = composition.GrowBoxEspRoot;
        _waterPumpsRoot = composition.WaterPumpsEspRoot;
        var rise = _growBoxRoot.LightSchedule?.Sunrise ?? 21600;
        var set = rise + (_growBoxRoot?.LightSchedule?.SunDuration ?? 64800);
        _rise = TimeSpan.FromSeconds(rise);
        _set = TimeSpan.FromSeconds(set);
        _sunDuration = _set - _rise;
        var sensorReadings = composition.SensorReadings.OrderBy(x => x.Created).ToArray(); 
        if (_chart is not null) 
            await _chart.UpdateChart(sensorReadings);
        _waterPumpActivities.Clear();
        foreach (var pump in _waterPumpsRoot?.Pumps ?? [])
        {
            _waterPumpActivities.Add(pump.Id, GetWaterPumpActivity(sensorReadings, pump.Id));
        }
        await InvokeAsync(StateHasChanged);
    }
    
    private double GetWaterPumpActivity(SensorReading[] sensorReadings, int pumpId)
    {
        var pumpType = $"wp{pumpId}_active";
        double activity = 0;
        var readings = sensorReadings
            .Where(x => x.Type == pumpType)
            .OrderBy(x => x.Created)
            .ToArray();

        DateTime? lastActive = null;
        var index = 0;
        for (; index < readings.Length; index++)
        {
            var reading = readings[index];
            if (Math.Abs(reading.Value - 1) < 0.001)
            {
                lastActive = reading.Created;
            }
            else if (lastActive != null)
            {
                activity += (reading.Created - lastActive.Value).TotalSeconds;
                lastActive = null;
            }
        }

        if (lastActive != null)
        {
            activity += (DateTime.UtcNow - lastActive.Value).TotalSeconds;
        }

        return activity;
    }
}
