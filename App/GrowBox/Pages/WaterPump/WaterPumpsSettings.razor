@using GrowBox.Abstractions.Model.EspApi
@using GrowBox.Controls.Overlay
@using GrowBox.Controls.Overlays
@using GrowBox.Services
@using Refit

@inject IOverlayService OverlayService
@inject NotificationService NotificationService
@inject ILogger<WaterPumpsSettings> Logger

@if (_waterPumpsRoot != null)
{
    <RadzenCard Variant="Variant.Filled">
        <RadzenStack Gap="1rem">
            <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                <div>
                    <RadzenIcon Icon="water"/>
                </div>
                <RadzenText TextStyle="TextStyle.Overline" style="margin-bottom: 0;">Pumps</RadzenText>
            </div>

            <div>
                <span> @_waterPumpsRoot.PumpMilliLiterPerMinute ml / min Pump Volume</span>
            </div>
            @foreach (var pump in _waterPumpsRoot.Pumps)
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Gap="1rem">
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px">
                            <RadzenText TextStyle="TextStyle.Overline" TextAlign="TextAlign.Start" style="margin-bottom: 0;">Pump @pump.Id</RadzenText>
                            <RadzenText TextStyle="TextStyle.Overline" TextAlign="TextAlign.Start" style="margin-bottom: 0;">@pump.LastRun.ToDateFromUnixSeconds()</RadzenText>
                        </div>
                        <RadzenSwitch
                            @bind-Value:get="(pump.AutoPumpBegin > -1)"
                            @bind-Value:set="(x) => pump.AutoPumpBegin = x ? 16200 : -1"
                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Toggle Waterpump schedule" }})" />
                        <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                            <RadzenSlider @bind-Value=@pump.Duration TValue="int" style="width: 100%; margin-left: 10px; margin-right: 16px" Step="60" Min="0" Max="@PumpMaximumSeconds"/>
                            <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Start" style="margin-bottom: 0; text-wrap: nowrap;">@(_waterPumpsRoot.PumpMilliLiterPerMinute * TimeSpan.FromSeconds(pump.Duration).TotalMinutes) ml</RadzenText>
                            <RadzenButton Icon="labs" ButtonStyle="ButtonStyle.Danger" Click="async () => await TestPump(pump)"/>
                        </div>
                        @if (pump.AutoPumpBegin > -1)
                        {
                            <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                                    <RadzenIcon Icon="schedule"/>
                                    <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Start" style="margin-bottom: 0; text-wrap: nowrap;">
                                        @TimeSpan.FromSeconds(pump.AutoPumpBegin)
                                    </RadzenText>
                                    <RadzenSlider @bind-Value=@pump.AutoPumpBegin TValue="int" style="width: 100%;" Step="@((30 * 60).ToString())" Min="-1" Max="@(60 * 60 * 24)"/>
                            </div>
                        }
                    </RadzenStack>
                </RadzenCard>
            }
            <RadzenButton Text="Set Pumps" ButtonStyle="ButtonStyle.Success" Click="UpdatePumps"/>
        </RadzenStack>
    </RadzenCard>
}

@code {
    private WaterPumpsEspRoot? _waterPumpsRoot;
    private IWaterPumpsEsp? _waterPumpsEsp;
    private int PumpMaximumSeconds => (int)TimeSpan.FromMinutes(3000d / _waterPumpsRoot?.PumpMilliLiterPerMinute ?? 1).TotalSeconds;

    [Parameter, EditorRequired]
    public string? WaterPumpsUrl { get; set; }
    
    protected override async Task OnParametersSetAsync()
    {
        await UpdateWaterPumpsData();
    }
    
    private async Task UpdatePumps()
    {
        if (_waterPumpsEsp is null || 
            _waterPumpsRoot?.Pumps is null ||
            _waterPumpsRoot.Pumps.Length <= 0) 
            return;
        try
        {

            var root = await _waterPumpsEsp.Set(new WaterPumps(_waterPumpsRoot.Pumps));
            if (root is null) throw new Exception("Water pumps response null.");
            await UpdateWaterPumpsData(root);
            
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"Water pumps update",
                Detail = "Success.",
                Duration = 2000
            };
            NotificationService.Notify(message);
        }
        catch (Exception e)
        {
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Water pumps update",
                Detail = "Failed.",
                Duration = 2000
            };
            NotificationService.Notify(message);
            Logger.LogError(e, $"Updating Pumps failed.");
        }
    }
    private async Task<bool> ConfirmWaterPumpTest(WaterPump pump)
    {
        Confirm confirm = new()
        {
            Caption = $"Water pump {pump.Id} Identification",
            Message = $"Are you sure you want to identify water pump {pump.Id}?",
            FailButtonStyle = ButtonStyle.Light,
            FailText = "Cancel",
            FailIcon = "",
            SuccessIcon = "labs",
            SuccessText = "Identify",
            SuccessButtonStyle = ButtonStyle.Danger,
        };

        var result = await OverlayService.ShowOverlay<ConfirmOverlay, Confirm>(confirm);
        return result.Success;
    }
    private async Task TestPump(WaterPump pump)
    {
        if (_waterPumpsEsp is null) return;

        var confirm = await ConfirmWaterPumpTest(pump);
        if (!confirm)
            return;

        try
        {
            var result = await _waterPumpsEsp.Test(pump with { Duration = 3 });
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"Water pump {pump.Id} Identification",
                Detail = "Success.",
                Duration = 2000
            };
            NotificationService.Notify(message);
        }
        catch (Exception e)
        {
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Water pump {pump.Id} Identification",
                Detail = "Failed. Message: " + e.Message,
                Duration = 2000
            };
            NotificationService.Notify(message);
        }
        
    }
    private async Task UpdateWaterPumpsData(WaterPumpsEspRoot? waterPumpsRoot = null)
    {
        if (_waterPumpsEsp is null)
        {
            if (!string.IsNullOrEmpty(WaterPumpsUrl))
                _waterPumpsEsp = RestService.For<IWaterPumpsEsp>(WaterPumpsUrl);
            else
                return;
        }

        try
        {
            _waterPumpsRoot = waterPumpsRoot ?? await _waterPumpsEsp.Get();
        }
        catch (Exception e)
        {
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Water pumps",
                Detail = "Can't connect to Water pumps at " + WaterPumpsUrl + " Message: " + e.Message,
                Duration = 2000
            };
            NotificationService.Notify(message);
            Logger.LogError(e, $"Unable to reach water pumps at {WaterPumpsUrl}.");
        }
        
    }
}