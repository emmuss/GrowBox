@using GrowBox.State
@using GrowBox.Abstractions.Model.EspApi
@using GrowBox.Controls.Overlay
@using GrowBox.Controls.Overlays
@using GrowBox.Pages.WaterPump
@using GrowBox.Services
@using Refit

@page "/growbox/{GrowBoxId:guid}/settings"

@inherits GrowBox.Controls.ReactiveComponent

@inject App App
@inject IJSRuntime Js
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IOverlayService OverlayService
@inject ILogger<GrowBoxSettings> Logger

@if (_growBoxRoot != null && _growBox != null) 
{
    <RadzenStack Gap="1rem" JustifyContent="JustifyContent.Stretch">
        @* HEADER *@
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Dark" Click=@(() => Js.InvokeVoidAsync("history.back")) />
            <RadzenButton Icon="settings" ButtonStyle="ButtonStyle.Dark" Click=@(() => NavigationManager.NavigateTo($"/growbox/{_growBox.Id}/edit")) />
        </RadzenStack>
        @* VPD Control *@
        <RadzenCard Variant="Variant.Filled">
            <RadzenStack Gap="1rem">
                <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                    <RadzenIcon Icon="water_voc" />
                    <RadzenText TextStyle="TextStyle.Overline" TextAlign="TextAlign.Center" style="margin-bottom: 0;">VPD Control</RadzenText>
                </div>
                <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                    <RadzenCheckBox
                        TValue="bool" Name="_isVPDControlActive"
                        @bind-Value=@_isVPDControlActive/>
                    <RadzenLabel Text="Enable VPD Control" Component="_isVPDControlActive" Style="margin-left: 8px; vertical-align: middle;"></RadzenLabel>
                </div>
                
                <RadzenSelectBar Size="ButtonSize.ExtraSmall" @bind-Value=_vdpPlantStage TValue="VPDControlPlantStage">
                    <Items>
                        <RadzenSelectBarItem Text="Off" Value="VPDControlPlantStage.Off" />
                        <RadzenSelectBarItem Text="Prop." Value="VPDControlPlantStage.Propagation" />
                        <RadzenSelectBarItem Text="Early Grow" Value="VPDControlPlantStage.EarlyGrow" />
                        <RadzenSelectBarItem Text="Late Grow" Value="VPDControlPlantStage.LateGrow" />
                        <RadzenSelectBarItem Text="Early Flower" Value="VPDControlPlantStage.EarlyFlower" />
                        <RadzenSelectBarItem Text="Late Flower" Value="VPDControlPlantStage.LateFlower" />
                    </Items>
                </RadzenSelectBar>
                
                

                <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                    <RadzenDatePicker TValue="DateTime"
                                      DateFormat="d"
                                      ShowTime="false"
                                      ShowSeconds="false"
                                      @bind-Value:get="@(_vdpPlantStageTimestamp.ToDateFromUnixSeconds())"
                                      @bind-Value:set="@((value) => _vdpPlantStageTimestamp = value.ToUnixSecondsFromDate())"></RadzenDatePicker>
                    <RadzenButton Text="Today" ButtonStyle="ButtonStyle.Secondary" Click="@(() => _vdpPlantStageTimestamp = DateTime.Now.Date.ToUnixSecondsFromDate())"/>
                </div>
                <RadzenButton Text="Set VPD Control " ButtonStyle="ButtonStyle.Success" Click="UpdateVPDControl"/>
            </RadzenStack>
        </RadzenCard>
        @* FAN *@
        <RadzenCard Variant="Variant.Filled">
            <RadzenStack Gap="1rem">
                <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                    <RadzenIcon Icon="tune" /> 
                    <RadzenText TextStyle="TextStyle.Overline" TextAlign="TextAlign.Center" style="margin-bottom: 0;">Fan Speed</RadzenText>
                </div>
                <RadzenSlider 
                    TValue="int" style="width: 100%;" Step="1" Min="0" Max="255"
                    @bind-Value="_fanSpeed" />
                <RadzenButton Text="Set Fan Speed" ButtonStyle="ButtonStyle.Success" Click="UpdateFanSpeed"/>
            </RadzenStack>
        </RadzenCard>
        @* LIGHT *@
        <RadzenCard Variant="Variant.Filled">
            <RadzenStack Gap="1rem">
                <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                    <RadzenIcon Icon="brightness_low" /> 
                    <RadzenText TextStyle="TextStyle.Overline" TextAlign="TextAlign.Center" style="margin-bottom: 0;">Light @_lightStepTextMap[_lightStep]</RadzenText>
                </div>
                <RadzenSlider
                    TValue="int" style="width: 100%;" Step="1" Min="0" Max="4"
                    
                    @bind-Value=_lightStep />
                <div style="display: flex; justify-content: start; align-items: center; gap: 16px;">
                    <RadzenIcon Icon="schedule"/>
                    <RadzenCheckBox
                        TValue="bool" Name="_sunScheduleEnabled"
                        @bind-Value=@_sunScheduleEnabled/>
                    <RadzenLabel Text="Enable Sun Schedule" Component="_sunScheduleEnabled" Style="margin-left: 8px; vertical-align: middle;"></RadzenLabel>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <RadzenText TextStyle="TextStyle.Overline" style="margin-bottom: 0;">@_rise.ToString(@"hh\:mm\:ss")</RadzenText>
                    <div style="display: flex; justify-content: start; align-items: center;">
                        <RadzenIcon Icon="north_east" />
                        <RadzenIcon Icon="sunny" /> 
                    </div>                    
                    <RadzenText TextStyle="TextStyle.Overline" style="margin-bottom: 0;">@_sunDuration.ToString(@"hh\:mm\:ss")</RadzenText>
                    <div style="display: flex; justify-content: start; align-items: center;">
                        <RadzenIcon Icon="sunny" /> 
                        <RadzenIcon Icon="south_east" />
                    </div>                    
                    <RadzenText TextStyle="TextStyle.Overline" style="margin-bottom: 0;">@_set.ToString(@"hh\:mm\:ss")</RadzenText>
                </div>
                <RadzenSlider
                    @bind-Value=@RiseAndSet 
                    TValue="IEnumerable<int>" style="width: 100%;" Step="1800" Min="0" Max="86400" Range="true" />
                <RadzenButton Text="Set Light" ButtonStyle="ButtonStyle.Success" Click="UpdateLight"/>
            </RadzenStack>
        </RadzenCard>
        @* WATER PUMPS *@
        <WaterPumpsSettings WaterPumpsUrl="@(_growBox.WaterPumpsUrl)" />
        @* DELETE *@
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Click=@(async () => { await DeleteGrowBox(); } ) />
        </RadzenStack>
    </RadzenStack>    
}


@code
{
    private VPDControlPlantStage _vdpPlantStage = VPDControlPlantStage.Propagation;
    private int _vdpPlantStageTimestamp = 0;
    private bool _isVPDControlActive = false;
    private Abstractions.Model.GrowBoxModel? _growBox;
    private GrowBoxEspRoot? _growBoxRoot;
    private IGrowBoxEsp? _growBoxService;
    private bool _sunScheduleEnabled = false;
    private TimeSpan _rise = TimeSpan.Zero;
    private TimeSpan _sunDuration = TimeSpan.Zero;
    private TimeSpan _set = TimeSpan.Zero;
    private IEnumerable<int> _riseAndSet = new int[] { 21600, 21600 + 64800 };
    private IEnumerable<int> RiseAndSet { get => _riseAndSet; set => SetRiseAndSet(value); }
    private int _fanSpeed = 0;
    private int _lightStep = 0;
    private readonly List<int> _lightStepMap = [254, 154, 103, 60, 1];
    private readonly List<string> _lightStepTextMap = ["Off", "40%", "60%", "80%", "100%"];
    private void SetRiseAndSet(IEnumerable<int> values)
    {
        var riseAndSet = values as int[] ?? values.ToArray();
        _riseAndSet = riseAndSet;
        _rise = TimeSpan.FromSeconds(riseAndSet.First());
        _set = TimeSpan.FromSeconds(riseAndSet.Last());
        _sunDuration = _set - _rise;
    }

    [Parameter] public Guid GrowBoxId { get; set; } = Guid.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ObserveParameter(() => GrowBoxId)
            .Where(x => x != Guid.Empty)
            .Select(App.GetAppGrowBox)
            .Do(x => _growBox = x.GrowBox)
            .Do(x => _growBoxService = RestService.For<IGrowBoxEsp>(x.GrowBox.GrowBoxUrl))
            .Select(_ => _growBoxService)
            .Select(x => x!.Get())
            .Switch()
            .Subscribe(UpdateGrowBoxData);
    }

    private void UpdateGrowBoxData(GrowBoxEspRoot? growBoxRoot)
    {
        _growBoxRoot = growBoxRoot;
        _fanSpeed = 255 - _growBoxRoot?.FanSpeed ?? 0;
        var light = (_growBoxRoot?.LightSchedule?.SunScheduleEnabled ?? false) ? _growBoxRoot.LightSchedule.SunTargetLight : (_growBoxRoot?.Light ?? 103);
        var lidx = _lightStepMap.IndexOf(light);
        _lightStep = lidx == -1 ? 0 : lidx;
        var rise = _growBoxRoot?.LightSchedule?.Sunrise ?? 21600;
        var set = rise + (_growBoxRoot?.LightSchedule?.SunDuration ?? 64800);
        RiseAndSet = [rise, set];
        _sunScheduleEnabled = _growBoxRoot?.LightSchedule?.SunScheduleEnabled ?? false;
        _vdpPlantStage = _growBoxRoot?.VPDControlPlantStage ?? VPDControlPlantStage.Propagation;
        _vdpPlantStageTimestamp = _growBoxRoot?.VPDControlPlantStageTimestamp ?? 0;
        StateHasChanged();
    }

    private async Task UpdateLight()
    {
        if (_growBoxService is null)
            return;

        var s = _lightStepMap[_lightStep];

        try
        {
            
            UpdateGrowBoxData(await _growBoxService.SetLightSchedule(
                new (
                    _sunScheduleEnabled, 
                    RiseAndSet.First(), 
                    RiseAndSet.Last() - RiseAndSet.First(), 
                    s, s)));
            
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"Light update",
                Detail = "Success.",
                Duration = 2000
            };
            NotificationService.Notify(message);
        }
        catch (Exception e)
        {
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Light update",
                Detail = "Failed.",
                Duration = 2000
            };
            NotificationService.Notify(message);
            Logger.LogError(e, "Update light failed.");
        }
    }
    private async Task UpdateFanSpeed()
    {
        if (_growBoxService is null)
            return;

        try
        {
            UpdateGrowBoxData(
                await _growBoxService.SetFanSpeed(new (255 - _fanSpeed)));
            
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = $"Fan speed update",
                Detail = "Success.",
                Duration = 2000
            };
            NotificationService.Notify(message);
        }
        catch (Exception e)
        {
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Fan speed update",
                Detail = "Error.",
                Duration = 2000
            };
            NotificationService.Notify(message);
            Logger.LogError(e, "Unable to update fan speed.");
        }
    }
    private async Task DeleteGrowBox()
    {
        if (_growBox is null) return;
        
        if (!await OverlayService.ConfirmDelete("GrowBox"))
            return;
        
        await App.DeleteGrowBox(_growBox); 
        NavigationManager.NavigateTo("/");
    }

    private async Task UpdateVPDControl()
    {
        if (_growBoxService is null)
            return;

        try
        {
            UpdateGrowBoxData(
                await _growBoxService.SetVPDControl(new VPDControlSpeedReq((int)_vdpPlantStage, _vdpPlantStageTimestamp)));
            
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "VPD Control update",
                Detail = "Success.",
                Duration = 2000
            };
            NotificationService.Notify(message);
        }
        catch (Exception e)
        {
            var message = new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "VPD Control update",
                Detail = "Error.",
                Duration = 2000
            };
            NotificationService.Notify(message);
            Logger.LogError(e, "Unable to update fan speed.");
        }
    }
}
