@using GrowBox.Controls.Overlay
@using GrowBox.Abstractions.Model
@using Blazor.MinimalApi.Client

@inherits OverlayDataBase<SnapshotSelection>
@inject MinimalHttpClient<DiaryRequest, Diary> DiaryService

<RadzenCard style="margin:0.5rem; padding:0.5rem; width: 90vw; max-width: 560px">
    <div style="display: flex; align-items: center; flex-wrap: nowrap; justify-content: flex-end; margin-bottom: 0.5rem">
        <RadzenText TextStyle="TextStyle.Overline" Text="Choose Snapshot" style="flex: 1; text-overflow: ellipsis; text-wrap: none; overflow:hidden;"/>
        <div style="flex: 0 0 0.5rem;">
        </div>
        <RadzenButton Click="@(() => { OverlayData = null; Fail();})" Icon="close" ButtonStyle="ButtonStyle.Light" style="width: 100%; flex: 0 0 32px;"/>
    </div>
    @if (_diary != null) 
    {
        <RadzenCarousel Auto="false" PagerOverlay="false" AllowPaging="false" ButtonShade="Shade.Default">
            <Items>
                @foreach (var snapshot in _snapshots.OrderByDescending(x => x.Created).Take(100))
                {
                    <RadzenCarouselItem>
                        <div>
                            <img src="@snapshot.Url" alt="@snapshot.Created.ToString("f")" 
                                 style="width: 100%; max-width: 520px; height: 45vh; object-fit:cover; border-radius: 8px; margin-top: 0.5rem"/>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" 
                                         Style="width: 100%; margin-top: 0.5rem">
                                <RadzenText Text="@snapshot.Created.ToString("f")" Style="margin-bottom: 0"/>
                                <RadzenButton Text="Select" Click="@(() => SelectSnapshot(snapshot))" />
                            </RadzenStack>
                        </div>
                    </RadzenCarouselItem>
                }
            </Items>
        </RadzenCarousel>
    }
</RadzenCard>


@code
{
    private Diary? _diary;
    private IEnumerable<DiarySnapshot> _snapshots = [];


    private void SelectSnapshot(DiarySnapshot diarySnapshot)
    {
        Console.WriteLine("wtf");
        if (OverlayData is null) return;
        OverlayData.DiarySnapshot = diarySnapshot;
        Succeed();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (OverlayData == null)
        {
            return;
        }

        _diary = await DiaryService.Get(new DiaryRequest(OverlayData.GrowBoxId));
        if (_diary == null)
        {
            await base.OnParametersSetAsync();
            return;
        }
        _snapshots = _diary.Snapshots;
        await base.OnParametersSetAsync();
    }
}